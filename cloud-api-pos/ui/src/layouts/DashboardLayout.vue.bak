<!--
  DashboardLayout.vue — macOS Tahoe 26 "Liquid Glass" app shell
  ─────────────────────────────────────────────────────────────────────
  Canvas:  deep forest-green dark + bokeh orbs
  Sidebar: frosted-glass panel, specular edge, glass nav pills
  Topbar:  glass bar with blur + specular line
-->
<template>
  <div class="tahoe-shell">

    <!-- ── Atmospheric bokeh ── -->
    <div class="bg-atmo" aria-hidden="true">
      <div class="bg-orb bo1" />
      <div class="bg-orb bo2" />
      <div class="bg-orb bo3" />
    </div>

    <!-- ── Mobile overlay ── -->
    <Transition name="fade-overlay">
      <div
        v-if="sidebarOpen"
        class="fixed inset-0 z-20 lg:hidden bg-overlay"
        @click="sidebarOpen = false"
      />
    </Transition>

    <!-- ── Sidebar ── -->
    <aside :class="['glass-sidebar', 'lg:static lg:translate-x-0', sidebarOpen ? 'translate-x-0' : '-translate-x-full']">

      <!-- Specular top edge -->
      <div class="sb-specular" aria-hidden="true" />

      <!-- Brand -->
      <div class="sb-brand">
        <div class="brand-icon">
          <!-- App icon grid -->
          <svg viewBox="0 0 28 28" fill="none" class="w-5 h-5">
            <rect x="2"  y="2"  width="11" height="11" rx="3"   fill="rgba(255,255,255,.95)" />
            <rect x="15" y="2"  width="11" height="11" rx="3"   fill="rgba(255,255,255,.5)"  />
            <rect x="2"  y="15" width="11" height="11" rx="3"   fill="rgba(255,255,255,.5)"  />
            <rect x="15" y="15" width="11" height="11" rx="3"   fill="rgba(255,255,255,.75)" />
          </svg>
        </div>
        <div>
          <div class="brand-name">Cloud POS</div>
          <div class="brand-sub">Nusantara Edition</div>
        </div>
      </div>

      <div class="sb-divider" />
      <div class="sb-section-label">Menu</div>

      <!-- Nav -->
      <nav class="sb-nav">
        <RouterLink
          v-for="item in NAV_ITEMS"
          :key="item.to"
          :to="item.to"
          :class="['nav-pill', isActive(item.to) ? 'nav-pill--active' : '']"
          @click="sidebarOpen = false"
        >
          <span class="nav-icon" v-html="item.icon" />
          <span class="nav-label">{{ item.label }}</span>
          <span v-if="isActive(item.to)" class="nav-dot" />
        </RouterLink>
      </nav>

      <div class="flex-1" />
      <div class="sb-divider" />

      <!-- User footer -->
      <div class="sb-footer">
        <div class="user-row">
          <div class="user-avatar">{{ adminInitial }}</div>
          <div class="user-info">
            <div class="user-name">{{ authStore.admin?.username }}</div>
            <div class="user-role">{{ authStore.admin?.role }}</div>
          </div>
        </div>
        <button class="logout-btn" @click="logout">
          <!-- Arrow-right-square logout icon -->
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
          </svg>
          Logout
        </button>
      </div>
    </aside>

    <!-- ── Main column ── -->
    <div class="main-col">

      <!-- Topbar -->
      <header class="glass-topbar">
        <div class="tb-specular" aria-hidden="true" />

        <!-- Hamburger (mobile) -->
        <button class="hamburger lg:hidden" @click="sidebarOpen = true" aria-label="Open menu">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>

        <!-- Page title -->
        <div class="tb-breadcrumb">
          <!-- Home chevron -->
          <svg class="tb-home-icon" fill="none" viewBox="0 0 20 20" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"
              d="M3 9.5L10 3l7 6.5V17a1 1 0 01-1 1H6a1 1 0 01-1-1v-4.5"/>
          </svg>
          <svg class="tb-chevron" fill="none" viewBox="0 0 16 16" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 4l4 4-4 4"/>
          </svg>
          <span class="tb-title-text">{{ currentPageTitle }}</span>
        </div>

        <div class="flex-1" />

        <!-- Role pill -->
        <span class="role-chip capitalize">{{ authStore.admin?.role }}</span>

        <!-- Avatar -->
        <div class="tb-avatar">{{ adminInitial }}</div>
      </header>

      <!-- Content -->
      <main class="content-area">
        <RouterView />
      </main>
    </div>

    <ToastContainer />
  </div>
</template>

<script setup>
import { ref, computed } from 'vue'
import { useRoute, useRouter } from 'vue-router'
import { useAuthStore } from '@/stores/auth.js'
import ToastContainer from '@/components/ToastContainer.vue'

const route       = useRoute()
const router      = useRouter()
const authStore   = useAuthStore()
const sidebarOpen = ref(false)

const adminInitial     = computed(() => (authStore.admin?.username ?? 'A').charAt(0).toUpperCase())
const currentPageTitle = computed(() => route.meta?.title?.replace(' — Cloud POS', '') ?? 'Dashboard')

function isActive(to) {
  if (to === '/') return route.path === '/'
  return route.path.startsWith(to)
}

async function logout() {
  await authStore.logout()
  router.push('/login')
}

const NAV_ITEMS = [
  {
    to: '/',
    label: 'Dashboard',
    icon: `<svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"
        d="M4 5a1 1 0 011-1h4a1 1 0 011 1v5a1 1 0 01-1 1H5a1 1 0 01-1-1V5z"/>
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"
        d="M14 5a1 1 0 011-1h4a1 1 0 011 1v2a1 1 0 01-1 1h-4a1 1 0 01-1-1V5z"/>
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"
        d="M4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4z"/>
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"
        d="M14 13a1 1 0 011-1h4a1 1 0 011 1v6a1 1 0 01-1 1h-4a1 1 0 01-1-1v-6z"/>
    </svg>`,
  },
  {
    to: '/outlets',
    label: 'Outlet',
    icon: `<svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"
        d="M3 9.5l9-7 9 7V20a1 1 0 01-1 1H4a1 1 0 01-1-1V9.5z"/>
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"
        d="M9 21V12h6v9"/>
    </svg>`,
  },
  {
    to: '/admins',
    label: 'Admin',
    icon: `<svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"
        d="M16 7a4 4 0 11-8 0 4 4 0 018 0z"/>
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"
        d="M12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
    </svg>`,
  },
]
</script>

<style scoped>
/* ── Canvas ──────────────────────────────────────────────── */
.tahoe-shell {
  position: relative;
  display: flex;
  height: 100svh;
  overflow: hidden;
  background: #f1f5f2;
}

/* Bokeh orbs hidden (not needed for light layout) */
.bg-atmo { display: none; }

/* ── Mobile overlay ──────────────────────────────────────── */
.bg-overlay { background: rgba(0,0,0,.45); backdrop-filter: blur(4px); }
.fade-overlay-enter-active, .fade-overlay-leave-active { transition: opacity .2s; }
.fade-overlay-enter-from,   .fade-overlay-leave-to     { opacity: 0; }

/* ── Sidebar  ─────────────────────────────────────────────── */
.glass-sidebar {
  position: fixed; top: 0; bottom: 0; left: 0;
  z-index: 30;
  width: 220px;
  display: flex; flex-direction: column;
  padding: 0 0 1rem;
  background: linear-gradient(175deg, #1a4731 0%, #1e5738 60%, #1a4731 100%);
  border-right: 1px solid rgba(0,0,0,.12);
  box-shadow: 4px 0 16px rgba(0,0,0,.15);
  transition: transform .22s cubic-bezier(.22,.68,0,1.15);
}
@media (min-width: 1024px) {
  .glass-sidebar { position: static; flex-shrink: 0; }
}

/* Specular strip — top inner edge */
.sb-specular {
  position: absolute; top: 0; left: 0; right: 0; height: 1px;
  background: rgba(255,255,255,.12);
}

/* Brand block */
.sb-brand { display: flex; align-items: center; gap: .75rem; padding: 1.25rem 1rem 1rem; }
.brand-icon {
  width: 36px; height: 36px; border-radius: 10px;
  background: rgba(255,255,255,.15);
  border: 1px solid rgba(255,255,255,.18);
  display: flex; align-items: center; justify-content: center;
  box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 2px 8px rgba(0,0,0,.2);
  flex-shrink: 0;
}
.brand-name { font-size: .875rem; font-weight: 700; color: #fff; letter-spacing: -.01em; }
.brand-sub  { font-size: .6rem; color: rgba(255,255,255,.45); text-transform: uppercase; letter-spacing: .08em; margin-top: .1rem; }

/* Divider */
.sb-divider { height: 1px; margin: .25rem .75rem; background: rgba(255,255,255,.1); }

/* Section label */
.sb-section-label {
  font-size: .58rem; font-weight: 700; color: rgba(255,255,255,.35);
  letter-spacing: .1em; text-transform: uppercase; padding: .625rem 1rem .3rem;
}

/* Nav */
.sb-nav { display: flex; flex-direction: column; gap: .2rem; padding: 0 .5rem; }

.nav-pill {
  position: relative;
  display: flex; align-items: center; gap: .625rem;
  padding: .55rem .75rem;
  border-radius: .75rem;
  font-size: .815rem; font-weight: 500;
  color: rgba(255,255,255,.55);
  text-decoration: none;
  border: 1px solid transparent;
  transition: color .15s, background .15s, border-color .15s;
}
.nav-pill:hover:not(.nav-pill--active) {
  color: rgba(255,255,255,.85);
  background: rgba(255,255,255,.08);
}
.nav-pill--active {
  color: #fff; font-weight: 600;
  background: rgba(255,255,255,.15);
  border-color: rgba(255,255,255,.18);
  box-shadow: 0 2px 8px rgba(0,0,0,.15);
}
.nav-icon {
  width: 1.1rem; height: 1.1rem; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
}
.nav-icon :deep(svg) { width: 100%; height: 100%; }
.nav-label { flex: 1; }
.nav-dot {
  width: 5px; height: 5px; border-radius: 50%;
  background: #a8cbbf;
  flex-shrink: 0;
}

/* Footer */
.sb-footer { padding: .75rem .75rem 0; display: flex; flex-direction: column; gap: .625rem; }
.user-row  { display: flex; align-items: center; gap: .625rem; }
.user-avatar {
  width: 30px; height: 30px; border-radius: 50%;
  background: rgba(255,255,255,.15);
  border: 1px solid rgba(255,255,255,.2);
  display: flex; align-items: center; justify-content: center;
  font-size: .75rem; font-weight: 700; color: #fff;
  flex-shrink: 0;
}
.user-name { font-size: .78rem; color: rgba(255,255,255,.8); font-weight: 500; }
.user-role { font-size: .62rem; color: rgba(255,255,255,.4); text-transform: capitalize; }
.logout-btn {
  display: flex; align-items: center; justify-content: center; gap: .5rem;
  padding: .45rem .75rem; border-radius: .625rem;
  font-size: .775rem; font-weight: 500; color: rgba(255,255,255,.55);
  background: rgba(0,0,0,.15); border: 1px solid rgba(255,255,255,.1);
  cursor: pointer; transition: background .15s, color .15s;
}
.logout-btn:hover { background: rgba(239,68,68,.25); color: #fca5a5; border-color: rgba(239,68,68,.3); }

/* ── Top bar ─────────────────────────────────────────────── */
.glass-topbar {
  position: relative; z-index: 10;
  height: 52px;
  display: flex; align-items: center; gap: .75rem;
  padding: 0 1.25rem; flex-shrink: 0;
  background: linear-gradient(90deg, #1a4731 0%, #1e5738 100%);
  border-bottom: 1px solid rgba(0,0,0,.12);
  box-shadow: 0 2px 8px rgba(0,0,0,.1);
}
/* Specular line on top edge */
.tb-specular {
  position: absolute; top: 0; left: 0; right: 0; height: 1px;
  background: rgba(255,255,255,.1);
}

.hamburger {
  padding: .35rem; border-radius: .5rem;
  color: rgba(255,255,255,.6); background: none; border: none; cursor: pointer;
  transition: color .15s, background .15s;
}
.hamburger:hover { color: #fff; background: rgba(255,255,255,.1); }

/* Breadcrumb */
.tb-breadcrumb { display: flex; align-items: center; gap: .35rem; }
.tb-home-icon  { width: 14px; height: 14px; color: rgba(255,255,255,.45); flex-shrink: 0; }
.tb-chevron    { width: 12px; height: 12px; color: rgba(255,255,255,.3); flex-shrink: 0; }
.tb-title-text {
  font-size: .875rem; font-weight: 600;
  color: rgba(255,255,255,.9); letter-spacing: -.01em;
}

.role-chip {
  font-size: .68rem; font-weight: 600;
  padding: .25rem .625rem; border-radius: 999px;
  background: rgba(255,255,255,.12);
  border: 1px solid rgba(255,255,255,.18);
  color: rgba(255,255,255,.75); letter-spacing: .04em;
}
.tb-avatar {
  width: 28px; height: 28px; border-radius: 50%;
  background: rgba(255,255,255,.15);
  border: 1px solid rgba(255,255,255,.2);
  display: flex; align-items: center; justify-content: center;
  font-size: .7rem; font-weight: 700; color: #fff;
}

/* ── Main column ─────────────────────────────────────────── */
.main-col {
  position: relative; z-index: 1;
  flex: 1; display: flex; flex-direction: column;
  overflow: hidden; min-width: 0;
  background: #f1f5f2;
}

/* ── Content area ────────────────────────────────────────── */
.content-area {
  flex: 1; overflow-y: auto;
  padding: 1.25rem 1.5rem;
  background: #f1f5f2;
  scrollbar-width: thin;
  scrollbar-color: rgba(0,0,0,.15) transparent;
}
.content-area::-webkit-scrollbar { width: 5px; }
.content-area::-webkit-scrollbar-thumb {
  background: rgba(0,0,0,.12); border-radius: 9999px;
}
</style>
